VertexLitGeneric
{
$baseTexture "models/props_ingame/paint_dropper_new_color"
$selfillum 1
$tintmasktexture	"models/props_ingame/paint_dropper_new_tint"
$detail				"models/props_ingame/paint_dropper_new_detail"

$detailscale	"[1 1]"
$detailblendfactor	0.7
$detailblendmode	2

$p_paintpower	"[255 255 255]"

Proxies
	{
	PaintOverlayColor
		{
		resultVar "$p_paintpower"
		paintPower 3
		}
	Equals
		{
		srcvar1	"$p_paintpower"
		resultVar	"$detailtint"
		}
	Equals
		{
		srcvar1	"$p_paintpower"
		resultVar	"$color"
		}
	}
}