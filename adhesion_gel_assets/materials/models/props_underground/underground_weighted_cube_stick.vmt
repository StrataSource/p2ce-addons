VertexLitGeneric
{
$basetexture "models/props_underground/underground_weighted_cube"
$bumpmap "paint/prop_paint_normal"
$envmap "paint/paint_envmap_hdr"
$envmaptint "[0.05 0.05 0.05]"
$normalmapalphaenvmapmask 1
$detail "paint/prop_paint_white"
$detailtint "{0 255 0}"
$detailScale 1
$detailblendmode 2
$phong 1
$phongexponent 50
$phongfresnelranges "[1 2 4]"
$phongboost 2

Proxies
	{
	PaintOverlayColor
		{
		resultVar "$detailtint"
		paintPower 5
		}
	}
}
