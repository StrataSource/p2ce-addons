VertexLitGeneric
{
$basetexture "models/props_underground/underground_paintdropper"
$bumpmap "models/props_underground/underground_paintdropper_normal"
$detail	"models/props_underground/underground_paintdropper_detail"

$detailscale	"[1 1]"
$detailblendfactor	1
$detailblendmode	1

$normalmapalphaenvmapmask 1
$phong 1
$phongexponent 5
$envmaptint "[.3 .3 .3 ]"
$phongboost 2
$phongfresnelranges "[5 1 2]"

$envmap env_cubemap

Proxies
	{
	PaintOverlayColor
		{
		resultVar "$detailtint"
		paintPower 1
		}
	}
}

