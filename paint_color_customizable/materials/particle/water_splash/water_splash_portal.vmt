SpriteCard
{
	$basetexture "particle/water_splash/water_splash"
	$vertexcolor 1
	$vertexalpha 1
	$translucent 1

	$overbrightfactor 1
	$blendframes 0
	
	$vertexcolorlerp 1
	$lerpcolor2 "{255 0 0}"

    "Proxies"
	{
		"PaintOverlayColor"
		{
            			"paintpower" "3"
            			"shouldAlpha" "1"
            			"resultVar" "$lerpcolor2"
		}
	}

}