Spritecard
{
	$translucent 1
	$basetexture "particle/paintblobs/paint_blob_sheet_1"
	$vertexcolor 1
	$vertexalpha 1

	$vertexcolorlerp 1
	$lerpcolor2 "{255 0 0}"

    "Proxies"
	{
		"PaintOverlayColor"
		{
            			"paintpower" "3"
            			"shouldAlpha" "1"
            			"resultVar" "$lerpcolor2"
		}
	}

}
